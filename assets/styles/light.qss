/* ===================================================================
   Tok-Transcript Modern SaaS Light Theme (Linear / Notion Inspired)
   =================================================================== */

/* --- Global Base --- */
QWidget {
    background-color: #f8fafc;
    color: #0f172a;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #f1f5f9;
}

/* --- Container Cards & Frames --- */
QFrame#cardFrame {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

QFrame#innerCardFrame {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

/* --- Typography / Labels (TRANSPARENT BACKGROUNDS) --- */
QLabel {
    background: transparent;
    background-color: transparent;
}

QLabel#headerTitle {
    font-size: 22px;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.3px;
    background: transparent;
}

QLabel#headerSubtitle {
    font-size: 13px;
    color: #64748b;
    background: transparent;
}

QLabel#sectionTitle {
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    background: transparent;
}

QLabel#statusLabel {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    background: transparent;
}

QLabel#badgeLabel {
    background-color: #f1f5f9;
    color: #334155;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#copiedBadge {
    background-color: #dcfce7;
    color: #15803d;
    border: 1px solid #86efac;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* --- Theme Switcher Segmented Pill --- */
QFrame#themeSwitcher {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 2px;
}

QPushButton#themeButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 14px;
    color: #64748b;
}

QPushButton#themeButton:hover {
    background-color: #e2e8f0;
    color: #0f172a;
}

QPushButton#themeButton:checked {
    background-color: #6366f1;
    color: #ffffff;
}

/* --- Inputs --- */
QLineEdit {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    selection-background-color: #6366f1;
}

QLineEdit:focus {
    border: 1px solid #6366f1;
    background-color: #ffffff;
}

QLineEdit::placeholder {
    color: #94a3b8;
}

/* --- Dropdowns / Combo Boxes --- */
QComboBox {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
    min-height: 22px;
}

QComboBox:hover {
    border: 1px solid #94a3b8;
}

QComboBox:focus {
    border: 1px solid #6366f1;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 4px;
    color: #0f172a;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
    outline: none;
}

/* --- Buttons --- */
QPushButton {
    background-color: #f1f5f9;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 600;
    outline: none;
}

QPushButton:hover {
    background-color: #e2e8f0;
    border-color: #94a3b8;
}

QPushButton:pressed {
    background-color: #cbd5e1;
}

QPushButton:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

/* Primary Accent Button (Transcribir) */
QPushButton#primaryButton {
    background-color: #6366f1;
    color: #ffffff;
    border: 1px solid #4f46e5;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 24px;
    border-radius: 8px;
}

QPushButton#primaryButton:hover {
    background-color: #4f46e5;
    border-color: #4338ca;
}

QPushButton#primaryButton:pressed {
    background-color: #4338ca;
}

QPushButton#primaryButton:disabled {
    background-color: #c7d2fe;
    color: #6366f1;
    border-color: #a5b4fc;
}

/* Small Action Button (Pegar / Copiar / Exportar) */
QPushButton#secondaryButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    color: #334155;
    font-weight: 500;
    padding: 6px 12px;
}

QPushButton#secondaryButton:hover {
    background-color: #f8fafc;
    color: #0f172a;
    border-color: #94a3b8;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    text-align: center;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
    height: 8px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6366f1, stop:1 #06b6d4);
    border-radius: 5px;
}

/* --- Transcript Text Area --- */
QPlainTextEdit {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 14px;
    font-size: 13px;
    line-height: 1.6;
    selection-background-color: #6366f1;
}

QPlainTextEdit:focus {
    border: 1px solid #94a3b8;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
